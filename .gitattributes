# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Development tooling and tests: needed in the repository, dead weight in a
# vendor install, so keep them out of the Composer dist archive.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
/phpstan.neon.dist  export-ignore
/tests              export-ignore
/workbench          export-ignore
/testbench.yaml     export-ignore
/.editorconfig      export-ignore
/build              export-ignore

# The specs the package was built from. History, not documentation.
/issues             export-ignore

# Repository governance: useful on GitHub, dead weight in a vendor install.
/CONTRIBUTING.md    export-ignore
/CODE_OF_CONDUCT.md export-ignore
/SECURITY.md        export-ignore
